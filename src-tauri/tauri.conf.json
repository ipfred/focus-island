{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "专注岛",
  "version": "../package.json",
  "identifier": "com.focus-island.desktop",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "FocusIsland",
        "width": 360,
        "height": 42,
        "minWidth": 4,
        "minHeight": 2,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "x": 750,
        "y": 0
      },
      {
        "label": "panel",
        "title": "专注清单",
        "width": 420,
        "height": 600,
        "minWidth": 340,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "shadow": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    },
    "shortDescription": "专注岛 - 灵动岛番茄钟",
    "longDescription": "屏幕顶部的灵动岛番茄钟，专注时在，需要时隐，从不打扰。"
  },
  "plugins": {
    "fs": {},
    "shell": {
      "open": false
    }
  }
}
